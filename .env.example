PORT=5050
MONGO_URI=mongodb://127.0.0.1:27017/shop-chat
SHOP_FRONTEND_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Sanity Configuration (Primary — legacy vars)
# ──────────────────────────────────────────────
SANITY_PROJECT_ID=idji8ni7
SANITY_DATASET=live-shop
SANITY_API_VERSION=2024-01-01
SANITY_API_TOKEN=

# ──────────────────────────────────────────────
# Sanity Multi-Database Configuration (Phase 2)
# ──────────────────────────────────────────────
# Each database is registered by role using SANITY_DB_<ROLE>_* env vars.
# The "primary" database uses the legacy vars above as fallback.
#
# ── Inventory Database ──
# SANITY_DB_INVENTORY_PROJECT_ID=<sanity-project-id>
# SANITY_DB_INVENTORY_DATASET=production
# SANITY_DB_INVENTORY_TOKEN=<write-token>
# SANITY_DB_INVENTORY_LABEL=Inventory Database
# SANITY_DB_INVENTORY_ENABLED=true
# SANITY_DB_INVENTORY_PRIORITY=2
# SANITY_DB_INVENTORY_PURPOSE=inventory,stock,products
#
# ── Billing Database ──
# SANITY_DB_BILLING_PROJECT_ID=<sanity-project-id>
# SANITY_DB_BILLING_DATASET=production
# SANITY_DB_BILLING_TOKEN=<write-token>
# SANITY_DB_BILLING_LABEL=Billing Database
# SANITY_DB_BILLING_ENABLED=true
# SANITY_DB_BILLING_PRIORITY=3
# SANITY_DB_BILLING_PURPOSE=bills,payments,transactions
#
# ── Public Database ──
# SANITY_DB_PUBLIC_PROJECT_ID=<sanity-project-id>
# SANITY_DB_PUBLIC_DATASET=production
# SANITY_DB_PUBLIC_TOKEN=<write-token>
# SANITY_DB_PUBLIC_LABEL=Public/Read-Only Database
# SANITY_DB_PUBLIC_ENABLED=true
# SANITY_DB_PUBLIC_PRIORITY=4
# SANITY_DB_PUBLIC_PURPOSE=public,catalog
#
# ── Legacy Numbered Projects (backward compatible) ──
# SANITY_PROJECT_2_ID=<sanity-project-id>
# SANITY_PROJECT_2_DATASET=production
# SANITY_PROJECT_2_TOKEN=<write-token>
# SANITY_PROJECT_2_LABEL=Project 2 — Secondary
# SANITY_PROJECT_2_ENABLED=true
# SANITY_PROJECT_2_PRIORITY=2

CHAT_SYNC_TOKEN=bd0a3b9c0d5f4e65a7c9f12e6b3a4d90
FIREBASE_SERVICE_ACCOUNT_JSON={}
FIREBASE_PROJECT_ID=web-push-shop
